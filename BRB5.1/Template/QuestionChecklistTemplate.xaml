<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BRB6.Template.QuestionChecklistTemplate">

    <ContentView.Content>
        <Grid BackgroundColor="#e6e6e6">
            <StackLayout BackgroundColor="#e6e6e6">
                <!-- Текст питання (без змін) -->
                <Grid>
                    <Label Text="{Binding Text}"
                           FontSize="22"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="Start">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuestionTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Grid Margin="0" Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Великий чекбокс: натискання записує час виконання -->
                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                              CheckedChanged="OnDoneChanged"
                              Color="Green"
                              Scale="1.8"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />

                    <!-- Період (зверху) / риска / фактичний час (знизу) -->
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="{Binding ExtInfo}"
                               FontSize="20"
                               HorizontalOptions="Center" />
                        <BoxView HeightRequest="1"
                                 Color="Gray"
                                 HorizontalOptions="Fill" />
                        <Label Text="{Binding FactTimeText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Фото (без змін) -->
                    <ImageButton Margin="0" Padding="0"
                                 Source="photo.png"
                                 ClassId="{Binding Id}"
                                 Grid.Column="2"
                                 BackgroundColor="Transparent"
                                 HeightRequest="60"
                                 Aspect="AspectFit"
                                 Clicked="TakePhotoAsync" />

                    <Label TextColor="Red"
                           Text="{Binding QuantityPhoto}"
                           ClassId="CountFoto"
                           FontSize="22"
                           FontAttributes="Bold"
                           Grid.Column="2"
                           VerticalOptions="Start"
                           HorizontalOptions="End" />

                    <!-- Редагування фото (без змін) -->
                    <ImageButton Margin="0" Padding="0"
                                 Source="edit.png"
                                 ClassId="{Binding Id}"
                                 Grid.Column="3"
                                 BackgroundColor="Transparent"
                                 HeightRequest="60"
                                 Aspect="AspectFit"
                                 Clicked="EditPhoto" />
                </Grid>

                <!-- Коментар (без змін) -->
                <Grid>
                    <Editor Placeholder="Введіть коментар"
                            Text="{Binding Note}"
                            AutoSize="TextChanges"
                            Unfocused="Editor_Completed"
                            Completed="Editor_Completed" />
                </Grid>
            </StackLayout>
        </Grid>
    </ContentView.Content>
</ContentView>
