<?xml version="1.0" encoding="utf-8"?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:controls="clr-namespace:BRB6.View"
            xmlns:iOsSpecific="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Class="BRB6.View.Settings"
            CurrentPageChanged="OnCurrentPageChanged"
            iOsSpecific:Page.UseSafeArea="True">

    <controls:BaseContentPage Title="Налаштування" x:Name="TabSettings">
        <ContentPage.Content>
            <StackLayout>
                <Grid ColumnDefinitions="*,*,2*" RowDefinitions="Auto,Auto">
                    <Label Text="{Binding Ver}" />
                    <Label Text="{Binding TypeScaner}" Grid.Column="1" />
                    <Label Text="{Binding SN}" Grid.Column="2" />
                    <Label Text="{Binding Model}" Grid.Row="1" Grid.ColumnSpan="2" />
                    <Label Text="{Binding Manufacturer}" Grid.Row="1" Grid.Column="2" />
                </Grid>

                <Grid ColumnDefinitions="2*,*">
                    <Picker Title="Оберіть торговий зал" 
                            x:Name="WarehousePicker"
                            ItemsSource="{Binding FilteredWarehousePicker}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedWarehouse}"
                            HorizontalOptions="Fill" />
                    <Entry Placeholder="Фільтр(від 3 букв)" x:Name="WarehouseFilterEntry" Grid.Column="1"
                           Unfocused="OnWarehouseFilterUnfocused" Completed="OnWarehouseFilterCompleted"/>
                </Grid>

                <StackLayout Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsViewAllWH}" />
                    <Label Text="Показувати всі склади" />
                </StackLayout>

                <Picker Title="Принтер"
                        ItemsSource="{Binding ListTypeUsePrinter}"
                        SelectedIndex="{Binding SelectedTypePrinter}"
                        HorizontalOptions="Fill" />

                <Grid ColumnDefinitions="*,*">
                    <Button Text="З.Довідники" HorizontalOptions="Fill" Clicked="OnClickLoad" />
                    <Button Text="З.Документи" Grid.Column="1" HorizontalOptions="Fill" Clicked="OnClickLoadDoc" />
                </Grid>

                <Picker Title="Рівень логування"
                        ItemsSource="{Binding ListTypeLog}"
                        SelectedIndex="{Binding SelectedTypeLog}"
                        HorizontalOptions="Fill" />

                <Grid ColumnDefinitions="*,3*,*,3*,*,3*">
                    <CheckBox IsChecked="{Binding IsVibration}" />
                    <Label Text="Вібрація" VerticalOptions="Center" Grid.Column="1" />
                    <CheckBox IsChecked="{Binding IsSound}" Grid.Column="2" />
                    <Label Text="Звук" VerticalOptions="Center" Grid.Column="3" />
                    <CheckBox IsChecked="{Binding IsFilterSave}" Grid.Column="4" />
                    <Label Text="Фільтр" VerticalOptions="Center" Grid.Column="5" />
                </Grid>

                <Picker Title="Якість фото" IsVisible="{Binding IsVisScan}"
                        ItemsSource="{Binding ListPhotoQuality}"
                        SelectedIndex="{Binding SelectedPhotoQuality}"
                        HorizontalOptions="Fill" />

                <StackLayout Orientation="Horizontal" IsVisible="{Binding IsVisScan}">
                    <Label Text="Стискання(відсотки)" />
                    <Frame Style="{StaticResource FrameStyle}" WidthRequest="50">
                        <controls:CustomEntry Style="{StaticResource EntryStyle}" Keyboard="{OnPlatform Numeric, iOS=Default}"
                                              Text="{Binding Compress}"/>
                    </Frame>
                </StackLayout>

                <ProgressBar ScaleY="2"
                             Progress="{Binding PB}"
                             VerticalOptions="EndAndExpand"
                             ProgressColor="Black" />

                <Button Text="Зберегти"
                        HorizontalOptions="Fill"
                        VerticalOptions="End"
                        Clicked="OnClickSave" />
            </StackLayout>
        </ContentPage.Content>
    </controls:BaseContentPage>

    <!-- Вкладка 2: Адмін -->
    <controls:BaseContentPage Title="Адмін" x:Name="TabAdmin">
        <ContentPage.Content>
            <StackLayout>
                <Grid IsVisible="{Binding IsVisBarCode}" HeightRequest="150" x:Name="GridZxing"/>

                <Grid ColumnDefinitions="*,3*,*,3*">
                    <CheckBox IsChecked="{Binding IsTest}" />
                    <Label Text="Тестова" Grid.Column="1" />
                    <CheckBox IsChecked="{Binding IsAutoLogin}" Grid.Column="2" />
                    <Label Text="Автологін" Grid.Column="3" />
                </Grid>

                <Button Text="Сканувати QR" IsVisible="{Binding IsVisScan}" Clicked="QRCodeScan" />

                <Grid ColumnDefinitions="2*,*,*">
                    <Picker Title="Компанія"
                            ItemsSource="{Binding ListCompany}"
                            SelectedIndex="{Binding SelectedCompany}"
                            HorizontalOptions="Fill" />
                    <Button Text="Зген." Grid.Column="1" HorizontalOptions="Fill" Clicked="OnClickGen" />
                    <Button Text="IP" Grid.Column="2" HorizontalOptions="Fill" Clicked="OnClickIP" />
                </Grid>

                <Frame Style="{StaticResource FrameStyle}">
                    <controls:CustomEntry Style="{StaticResource EntryStyle}" Text="{Binding ApiUrl1}"/>
                </Frame>

                <Frame Style="{StaticResource FrameStyle}" IsVisible="{Binding IsVisApi2}">
                    <controls:CustomEntry Style="{StaticResource EntryStyle}" Text="{Binding ApiUrl2}" IsVisible="{Binding IsVisApi2}"/>
                </Frame>

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                    <Button Text="Send db-log" HorizontalOptions="Fill" Clicked="OnCopyDB" />
                    <Button Text="Від.Бази" Grid.Column="1" HorizontalOptions="Fill" Clicked="OnRestoreDB" />
                    <Button Text="Очистити базу" Grid.Row="1" HorizontalOptions="Fill" Clicked="OnClean" />
                    <Button Text="Очистити лог" Grid.Row="1" Grid.Column="1" HorizontalOptions="Fill" Clicked="OnCleanLog" />
                    <Button Text="Info" Grid.Row="2" HorizontalOptions="Fill" Clicked="OnInfo" />
                    <Button Text="Завантаж. з log" Grid.Row="2" Grid.Column="1" HorizontalOptions="Fill" Clicked="LoadLog" />
                </Grid>

                <Button Text="Зберегти" HorizontalOptions="Fill" VerticalOptions="EndAndExpand" Clicked="OnClickSave" />
            </StackLayout>
        </ContentPage.Content>
    </controls:BaseContentPage>

    <!-- Вкладка 3: Склади (VerticalStackLayout залишено, але генерується тільки при переході) -->
    <controls:BaseContentPage Title="Склади" x:Name="TabWarehouses">
        <ContentPage.Content>
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Фільтр зверху -->
                <Grid ColumnDefinitions="1*,5*" Grid.Row="0">
                    <CheckBox IsChecked="{Binding IsFilterWHChecked}" CheckedChanged="CheckFilterWH" />
                    <Frame Style="{StaticResource FrameStyle}" Margin="5" Grid.Column="1">
                        <controls:CustomEntry Style="{StaticResource EntryStyle}" TextChanged="FilterWH" Text="{Binding TextFilterWH}" />
                    </Frame>
                </Grid>

                <Grid VerticalOptions="StartAndExpand" Grid.Row="1">
                    <ScrollView>
                        <VerticalStackLayout x:Name="FilterWarehouseList" />
                    </ScrollView>
                </Grid>

                <!-- Кнопка зберегти знизу -->
                <Button Text="Зберегти"
                        Grid.Row="2"
                        HorizontalOptions="Fill"
                        Clicked="OnClickSave" />
            </Grid>
        </ContentPage.Content>
    </controls:BaseContentPage>

    <!-- Вкладка 4: Log (Посторінкове завантаження з кінця) -->
    <controls:BaseContentPage Title="Log" x:Name="TabLog">
        <ContentPage.Content>
            <Grid RowDefinitions="*,Auto">
                <!-- Текст логів -->
                <ScrollView Grid.Row="0">
                    <Label Text="{Binding DisplayLogText}" 
                           FontSize="12" 
                           FontFamily="Monospace" 
                           LineBreakMode="WordWrap" 
                           Padding="5" />
                </ScrollView>

                <!-- Кнопка прибита до низу -->
                <Button Grid.Row="1"
                        Text="Завантажити старіші (ще 50)"
                        HorizontalOptions="Fill"
                        Clicked="OnLoadMoreLogsClicked" />
            </Grid>
        </ContentPage.Content>
    </controls:BaseContentPage>
</TabbedPage>