<?xml version="1.0" encoding="utf-8"?>

<local:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:local="clr-namespace:BRB6.View"
                      xmlns:Model="clr-namespace:BRB5.Model;assembly=BRB5.Model"
                       x:Class="BRB6.View.DocItem">
    <NavigationPage.TitleView>
        <StackLayout Spacing="15" Orientation="Horizontal" Padding="0,0,10,0">
            <Label Text="{Binding NumberDoc}" VerticalOptions="Center"/>
            <Label Text="{Binding ExtInfo}" VerticalOptions="Center"/>
            <!--<Picker x:Name="ReasonPicker"
                    IsEnabled="{Binding IsVisF5Act}"
                    IsVisible="{Binding IsVisF5Act}"
                    Title="Причина"
                    ItemsSource="{Binding Reasons}"
                    ItemDisplayBinding="{Binding NameReason}"
                    SelectedIndexChanged="SelectReason"
                    SelectedItem="{Binding SelectedReason}" />-->            
        </StackLayout>
    </NavigationPage.TitleView>
    <ContentPage.Content>       
        <StackLayout>

            <StackLayout IsVisible="{Binding IsVisibleDocF6}">
                <Picker Title="дата"
                        Unfocused="DocNameFocus"
                        x:Name="DocDate"
                        ItemsSource="{Binding ListDataStr}"
                        ItemDisplayBinding="{Binding DateString}"
                        SelectedIndex="{Binding SelectedDataStr}" />
                <Frame Style="{StaticResource FrameStyle}">
                    <local:CustomEntry Style="{StaticResource EntryStyle}"
                                          x:Name="DocName"
                                          Placeholder="номер"
                                          Text="{Binding NumberOutInvoice}" >
                    </local:CustomEntry>
                </Frame>
            </StackLayout>
            <!--<VerticalStackLayout>
                <Grid RowSpacing="1" ColumnSpacing="1" ColumnDefinitions="3*,2*,2*,3*"  
                      IsVisible="{Binding IsViewReason}"
                      Padding="1"  BackgroundColor="#adaea7">
                    <Label Text="Код" Grid.Column="0" BackgroundColor="White" />
                    <Label Text="План" Grid.Column="1" BackgroundColor="White" />
                    <Label Text="Факт" Grid.Column="2" BackgroundColor="White" />
                    <Label Text="Проблемні" Grid.Column="3" BackgroundColor="White"  />
                </Grid>
                <Grid RowSpacing="1" ColumnSpacing="1" ColumnDefinitions="3*,2*,2*" 
                      IsVisible="{Binding IsViewNoReason}"
                      Padding="1"  BackgroundColor="#adaea7">
                    <Label Text="Код" Grid.Column="0" BackgroundColor="White" />
                    <Label Text="План" Grid.Column="1" BackgroundColor="White" />
                    <Label Text="Факт" Grid.Column="2" BackgroundColor="White" />
                </Grid>
            </VerticalStackLayout>-->
            
            <Grid VerticalOptions="StartAndExpand">
                <ScrollView>
                    <StackLayout x:Name="DocWaresStackLayout" />
                </ScrollView>
            </Grid>
            <!-- ПАНЕЛЬ 1: Стара текстова панель (ховається для Sim23 на сенсорних пристроях) -->
            <StackLayout VerticalOptions="End" Orientation="Horizontal" IsVisible="{Binding IsOldPanelVisible}">

                <Label Text="F2-" IsVisible="{Binding IsVisF2}" FontSize="16" Grid.Column="6" TextColor="#ff5c5c" VerticalOptions="Center" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F2Save" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Збер" IsVisible="{Binding IsVisF2}" FontSize="18" Grid.Column="7" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F2Save" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="F3-" FontSize="16" Grid.Column="6" TextColor="#ff5c5c" VerticalOptions="Center" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F3Scan" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Скан" FontSize="18" Grid.Column="7" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F3Scan" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="F4-" FontSize="16" Grid.Column="6" TextColor="#ff5c5c" VerticalOptions="Center" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F4WrOff" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Спис" FontSize="18" Grid.Column="7" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F4WrOff" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="F5-" IsVisible="{Binding IsVisF5Act}" FontSize="16" Grid.Column="6" TextColor="#ff5c5c" VerticalOptions="Center" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F5Act" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Акт" IsVisible="{Binding IsVisF5Act}" FontSize="18" Grid.Column="7" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F5Act" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="F6-" IsVisible="{Binding IsViewInputDateDoc}" FontSize="16" Grid.Column="6" TextColor="#ff5c5c" VerticalOptions="Center" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F6Doc" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Док" IsVisible="{Binding IsViewInputDateDoc}" FontSize="18" Grid.Column="7" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="F6Doc" />
                    </Label.GestureRecognizers>
                </Label>

            </StackLayout>

            <!-- ПАНЕЛЬ 2: Нова панель з картинками (Тільки для Sim23 без фізичної клавіатури) -->
            <Grid VerticalOptions="End" ColumnDefinitions="*, Auto" Padding="0" ColumnSpacing="25" IsVisible="{Binding IsImagePanelVisible}">

                <!-- Кнопка збереження (займає ліву частину екрану) -->
                <Button Grid.Column="0"
                        Clicked="F2Save" 
                        IsVisible="{Binding IsVisF2}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="60">
                    <Button.Triggers>
                        <!-- Стан 1: Немає змін (Збережено) -->
                        <DataTrigger TargetType="Button" Binding="{Binding HasChanges}" Value="False">
                            <Setter Property="Text" Value="Збережено документ" />
                            <Setter Property="BackgroundColor" Value="LightGray" />
                            <Setter Property="TextColor" Value="Black" />
                        </DataTrigger>

                        <!-- Стан 2: Є зміни (Треба зберегти) -->
                        <DataTrigger TargetType="Button" Binding="{Binding HasChanges}" Value="True">
                            <Setter Property="Text" Value="Зберегти документ" />
                            <Setter Property="BackgroundColor" Value="#4CAF50" />
                            <!-- Зелений колір -->
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Блок з картинками (вирівняний по правому краю) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="25" HorizontalOptions="End" VerticalOptions="Center">
                    <ImageButton Source="barcode_scanning.png" 
                                 Clicked="F3Scan" 
                                 HeightRequest="60" WidthRequest="60" 
                                 BackgroundColor="Transparent" Aspect="AspectFit" />

                    <ImageButton Source="hand_input.png" 
                                 Clicked="F4WrOff" 
                                 HeightRequest="60" WidthRequest="60" 
                                 BackgroundColor="Transparent" Aspect="AspectFit" />
                </HorizontalStackLayout>

            </Grid>
        </StackLayout>
    </ContentPage.Content>
</local:BaseContentPage>