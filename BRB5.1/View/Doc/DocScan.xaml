<?xml version="1.0" encoding="utf-8"?>
<controls:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:controls="clr-namespace:BRB6.View"
                          x:Class="BRB6.View.DocScan">

    <ContentPage.Resources>
        <controls:CodeUnitToKeyboardConverter x:Key="CodeUnitToKeyboardConverter" />
        <!-- Додаємо наш новий конвертер -->
        <controls:ZeroToNullConverter x:Key="ZeroToNullConverter" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <StackLayout>
            <Grid x:Name="GridZxing" IsVisible="{Binding IsVisScan}" HeightRequest="200" />

            <!-- Зменшено відступи: RowSpacing=5, Padding=5 -->
            <Grid VerticalOptions="StartAndExpand" RowDefinitions="Auto,Auto,Auto,Auto,5*" RowSpacing="5" Padding="5">

                <!-- Рамка навколо назви зі зменшеним Padding -->
                <Frame Style="{StaticResource FrameStyle}" Padding="7">
                    <Label Text="{Binding ScanData.NameWares}" FontSize="24" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                </Frame>

                <!-- Зменшено відступи між рядками та колонками до 5 -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="5">

                    <Frame Style="{StaticResource FrameStyle}">
                        <controls:CustomEntry Style="{StaticResource EntryStyle}"
                                              Text="{Binding ScanData.BarCode}"
                                              x:Name="inputBarCode"
                                              Completed="HandBarCode"
                                              Keyboard="Numeric"
                                              Placeholder="Штрихкод" />
                    </Frame>

                    <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                        <Frame Style="{StaticResource FrameStyle}" IsVisible="{Binding IsShowPlan}" >
                            <!-- Додано конвертер до поля План -->
                            <controls:CustomEntry Style="{StaticResource EntryStyle}"
                                                  Placeholder="План"
                                                  Text="{Binding ScanData.QuantityOrder, Converter={StaticResource ZeroToNullConverter}}"
                                                  IsReadOnly="True" />
                        </Frame>

                        <Frame Grid.Column="1" Style="{StaticResource FrameStyle}">
                            <!-- Додано конвертер до поля Заг. к-сть -->
                            <controls:CustomEntry Style="{StaticResource EntryStyle}"
                                                  Text="{Binding ScanData.BeforeQuantity, Converter={StaticResource ZeroToNullConverter}}"
                                                  Placeholder="Заг. к-сть"
                                                  IsReadOnly="True" />
                        </Frame>
                    </Grid>

                    <!-- Забрали окремий Label "=" і перерозподілили колонки -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="2*, Auto, Auto, 1.5*, 2*" ColumnSpacing="3" VerticalOptions="Center">

                        <Frame Grid.Column="0" Style="{StaticResource FrameStyle}">
                            <!-- Додано конвертер до InputQuantity -->
                            <controls:CustomEntry Style="{StaticResource EntryStyle}" 
                                                  IsEnabled="{Binding IsNotAddAuto}"
                                                  Text="{Binding InputQuantity, Converter={StaticResource ZeroToNullConverter}}"
                                                  x:Name="inputQ"
                                                  Unfocused="UnfocusedInputQ"
                                                  TextChanged="CalcQuantity"
                                                  Completed="CompletedInputQ"
                                                  Placeholder="К-сть"
                                                  Keyboard="{OnPlatform Numeric, iOS=Default}" />
                        </Frame>

                        <Label Text="{Binding ScanData.NameUnit}" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Margin="3,0" />
                        <Label Text="x" Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Margin="3,0" />

                        <Frame Style="{StaticResource FrameStyle}" Grid.Column="3">
                            <controls:CustomEntry Style="{StaticResource EntryStyle}"
                                                  Text="{Binding ScanData.Coefficient, Converter={StaticResource ZeroToNullConverter}}"
                                                  Placeholder="1"
                                                  IsReadOnly="True" />
                        </Frame>

                        <Frame Style="{StaticResource FrameStyle}" Grid.Column="4">
                            <!-- Знак "=" тепер як плейсхолдер, значення конвертується -->
                            <controls:CustomEntry Style="{StaticResource EntryStyle}"
                                                  Text="{Binding ScanData.Quantity, Converter={StaticResource ZeroToNullConverter}}"
                                                  Placeholder="="
                                                  IsReadOnly="True"
                                                  HorizontalTextAlignment="Center" />
                        </Frame>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" IsVisible="{Binding IsViewReason}">
                    <Picker x:Name="ReasonPicker" Title="Оберіть причину"
                            FontSize="18"
                            IsEnabled="False"
                            ItemDisplayBinding="{Binding NameReason}"
                            SelectedItem="{Binding SelectedReason, Mode=TwoWay}"     
                            Unfocused="ReasonUnfocus"                       
                            SelectedIndexChanged="ReasonPicker_SelectedIndexChanged" />

                    <Label Text="{Binding SelectedReason.NameReason, FallbackValue='Оберіть причину'}"
                           VerticalOptions="Center" Margin="4"  FontSize="18" BackgroundColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer  Tapped="ReasonFocus" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <!-- ПАНЕЛЬ 2: Без фізичної клавіатури (Padding зменшено) -->
                <Grid  Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="5" Padding="5" >
                    <Button Grid.Column="0" Text="Обнулити" Clicked="Reset" BackgroundColor="#ff5c5c" TextColor="White" CornerRadius="5" />
                    <Button Grid.Column="1" Text="Замінити" Clicked="ResetAndAdd" BackgroundColor="#816f20" TextColor="White" CornerRadius="5" />
                    <Button Grid.Column="2" Text="ОК" Clicked="CompletedInputQ" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="5" />
                </Grid>
                <CollectionView Grid.Row="4" ItemsSource="{Binding ListWares}" x:Name="CollectionViewWares" SelectionMode="Single">

                    <CollectionView.Header>
                        <!-- Ідеально симетричні колонки: №(Auto), Назва(*), К-сть(Auto), Причина(Auto) -->
                        <Grid RowSpacing="1" ColumnSpacing="1" Padding="1" BackgroundColor="#adaea7" ColumnDefinitions="Auto, *, Auto, Auto">

                            <!-- Порожній блок для вирівнювання колонки № (якщо вона увімкнена) -->
                            <Label Grid.Column="0" WidthRequest="25" BackgroundColor="White" IsVisible="{Binding Config.IsVisOrderF3}" />

                            <Label Grid.Column="1" Text="Назва" BackgroundColor="White" Padding="3,0"/>

                            <!-- Фіксована ширина під розмір слова "к-сть" (~55 пікселів) -->
                            <Label Grid.Column="2" Text="к-сть" WidthRequest="55" HorizontalTextAlignment="Center" BackgroundColor="White" Padding="3,0"/>

                            <!-- Фіксована ширина під розмір слова "прич" (~60 пікселів) -->
                            <Label Grid.Column="3" Text="прич" WidthRequest="60" HorizontalTextAlignment="Center" BackgroundColor="White" Padding="3,0" IsVisible="{Binding IsNotSim23}" />

                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowSpacing="1" ColumnSpacing="1" Padding="1" BackgroundColor="#adaea7" ColumnDefinitions="Auto, *, Auto, Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnListViewWaresItemTapped" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0" Text="{Binding OrderDoc}" WidthRequest="25" HorizontalTextAlignment="Center" BackgroundColor="{Binding GetBackgroundColor}" IsVisible="{Binding Config.IsVisOrderF3}"/>

                                <Label Grid.Column="1" Text="{Binding NameWares}" LineBreakMode="NoWrap" BackgroundColor="{Binding GetBackgroundColor}" Padding="3,0" />

                                <!-- Та сама фіксована ширина (55), щоб ідеально стати під заголовок -->
                                <Label Grid.Column="2" Text="{Binding InputQuantity}" WidthRequest="55" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" BackgroundColor="{Binding GetBackgroundColor}" Padding="3,0" />

                                <!-- Та сама фіксована ширина (60) -->
                                <Label Grid.Column="3" Text="{Binding NameReason}" WidthRequest="60" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" BackgroundColor="{Binding GetBackgroundColor}" Padding="3,0"
                       IsVisible="{Binding BindingContext.IsNotSim23, Source={x:Reference CollectionViewWares}}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

            <!-- ПАНЕЛЬ 1: З фізичною клавіатурою -->
            <StackLayout VerticalOptions="End" Orientation="Horizontal" Padding="5" IsVisible="{Binding IsNotSoftKeyboard}">
                <Label Text="F1-" FontSize="16" TextColor="#ff5c5c" />
                <Label Text="обнул" FontSize="18" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Reset" />
                    </Label.GestureRecognizers>
                </Label>

                <StackLayout Orientation="Horizontal" IsVisible="{Binding IsNotSim23}">
                    <Label Text="F2-" FontSize="16" TextColor="#ff5c5c">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Up" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="↑" FontSize="18" TextColor="#816f20">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Up" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="F3-" FontSize="16" TextColor="#ff5c5c">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Down" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="↓" FontSize="18" TextColor="#816f20">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Down" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>

                <Label Text="F4-" FontSize="16" TextColor="#ff5c5c" IsVisible="{Binding IsShowAddAuto}" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AddAuto" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="+1" FontSize="18" TextColor="#816f20" IsVisible="{Binding IsShowAddAuto}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AddAuto" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="F8-" FontSize="16" TextColor="#ff5c5c">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ResetAndAdd" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Замін" FontSize="18" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ResetAndAdd" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="⏎-" FontSize="16" FontAttributes="Bold" TextColor="#ff5c5c">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CompletedInputQ" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Ent" FontSize="18" TextColor="#816f20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CompletedInputQ" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

           
        </StackLayout>
    </ContentPage.Content>
</controls:BaseContentPage>