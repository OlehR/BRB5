<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BRB6.ViewModel"
             xmlns:models="clr-namespace:BRB5.Model;assembly=BRB5.Model"
             x:DataType="vm:DocItemCheckVM"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"                          
             xmlns:tmpl="clr-namespace:BRB6.Template"
             BackgroundColor="White"
             x:Class="BRB6.View.DocItemCheck">
    <NavigationPage.TitleView>
        <Grid BackgroundColor="White" >
            <Label Text="{Binding Title}" FontSize="20"  FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"  Margin="12,0,0,0" />
        </Grid>
    </NavigationPage.TitleView>
    <Grid RowDefinitions="*,Auto">

        <!-- ═══ TABLE ═══ -->
        <Grid RowDefinitions="Auto,*">

            <!-- Таблиця з рамкою -->
            <Border
                Grid.Row="0" Grid.RowSpan="2"
                Stroke="#D3D3D3" StrokeThickness="1"
                Margin="5,5,5,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*">

                    <!-- Заголовок таблиці -->
                    <Grid
                        Grid.Row="0"
                        Padding="5,5" BackgroundColor="White"
                        ColumnDefinitions="32,*,56,64" ColumnSpacing="0">

                        <BoxView Grid.Column="0" Color="Transparent" />

                        <Label
                            Grid.Column="1"
                            Text="Назва товару" FontSize="13"
                            TextColor="Black" FontAttributes="Bold"
                            HorizontalOptions="Center" VerticalOptions="Center" />

                        <!-- Вертикальний розмежовувач -->
                        <BoxView
                            Grid.Column="2"
                            WidthRequest="1" BackgroundColor="#D3D3D3"
                            HorizontalOptions="Start" VerticalOptions="Fill" />

                        <Label
                            Grid.Column="2"
                            Text="Облік" FontSize="13"
                            TextColor="Black" FontAttributes="Bold"
                            HorizontalOptions="Center" VerticalOptions="Center" />

                        <!-- Вертикальний розмежовувач -->
                        <BoxView
                            Grid.Column="3"
                            WidthRequest="1" BackgroundColor="#D3D3D3"
                            HorizontalOptions="Start" VerticalOptions="Fill" />

                        <Label
                            Grid.Column="3"
                            Text="Викл-ка" FontSize="13"
                            TextColor="Black" FontAttributes="Bold"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <!-- Горизонтальний розмежовувач після заголовку -->
                    <BoxView
                        Grid.Row="0"
                        HeightRequest="1" BackgroundColor="#D3D3D3"
                        VerticalOptions="End" />

                    <!-- Список товарів -->
                    <CollectionView  Grid.Row="1" x:Name="WaresCollection" ItemsSource="{Binding Wares}" SelectedItem="{Binding SelectedWare}" SelectionMode="Single">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DocWaresEx">
                                <Grid>
                                    <!-- Фон рядка: сірий якщо відмічено, білий якщо ні -->
                                    <Grid Padding="5,5" ColumnDefinitions="32,*,56,64" ColumnSpacing="0" BackgroundColor="{Binding RowColor}">

                                        <!-- Checkbox -->
                                        <CheckBox
                                            Grid.Column="0"
                                            IsChecked="{Binding IsInputQuantity}" Color="#7B2FBE"
                                            VerticalOptions="Center" HorizontalOptions="Center" />

                                        <!-- Назва -->
                                        <Grid  Grid.Column="1" RowDefinitions="*, Auto">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer  Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenImagePopupCommand}" 
                                                                       CommandParameter="{Binding}" />
                                            </Grid.GestureRecognizers>
                                            <Image IsVisible="{Binding IsPromo}" Source="promo.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Start" VerticalOptions="Start" />
                                            <Label Text="{Binding NameWareView}" FontSize="14" TextColor="#1A1A1A" LineBreakMode="WordWrap"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />                                            
                                            <Border Grid.Row="1" IsVisible="{Binding IsSelected}" BackgroundColor="White" 
                                                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,4">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Image Source="barcode.png" HeightRequest="15" />
                                                    <Label Text="{Binding BarCode}" LineBreakMode="NoWrap" TextColor="Black" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>

                                        <!-- Вертикальний розмежовувач -->
                                        <BoxView
                                            Grid.Column="2"
                                            WidthRequest="1" BackgroundColor="#D3D3D3"
                                            HorizontalOptions="Start" VerticalOptions="Fill" />

                                        <!-- Облік -->
                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding QuantityMax}" FontSize="14"
                                            TextColor="#1A1A1A" HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                                        <!-- Вертикальний розмежовувач -->
                                        <BoxView
                                            Grid.Column="3"
                                            WidthRequest="1" BackgroundColor="#D3D3D3"
                                            HorizontalOptions="Start" VerticalOptions="Fill" />

                                        <!-- Викладка -->

                                        <Grid Grid.Column="3" BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                    Path=BindingContext.OpenDialogCommand}" CommandParameter="{Binding}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Quantity}" FontSize="14" TextColor="#1A1A1A" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>

                                    <!-- Горизонтальний розмежовувач -->
                                    <BoxView
                                        HeightRequest="1" BackgroundColor="#D3D3D3"
                                        VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                      
                    </CollectionView>

                    <!-- Індикатор завантаження -->
                    <ActivityIndicator
                        Grid.Row="1"
                        IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                        Color="#7B2FBE" VerticalOptions="Center"
                        HorizontalOptions="Center" />

                </Grid>
            </Border>
        </Grid>


        <!-- ═══ FOOTER BUTTON ═══ -->
        <Grid  Grid.Row="2" BackgroundColor="White">

            <Button
                Text="Відвантажити корзину"
                Command="{Binding LoadCartCommand}"
                BackgroundColor="#7B2FBE"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="28"
                HeightRequest="56"
                HorizontalOptions="Fill" />
        </Grid>
        <tmpl:MRDialog Grid.RowSpan="2" DialogTitle="Оновіть кількість для винесення товару" 
                       BindingContext="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext}" />

        <Grid Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="{Binding IsImagePopupVisible}" ZIndex="100">
            <!-- Закриття при кліку на фон -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseImagePopupCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" Margin="20" Padding="15" StrokeShape="RoundRectangle 12"
                    HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" HeightRequest="400">
                <!-- Блокуємо закриття при кліку на саму білу картку -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, *, Auto">
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Label Text="✕" FontSize="20" FontAttributes="Bold" TextColor="Gray"
                               HorizontalOptions="Start" VerticalOptions="Center" Padding="0,0,20,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseImagePopupCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="Інформація про товар" FontSize="18" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <ffimageloading:CachedImage Grid.Row="1" ErrorPlaceholder="photo.png" 
                                                Source="{Binding PopupImageUrl}" 
                                                HorizontalOptions="Fill" VerticalOptions="Fill" Aspect="AspectFit" />

                    <Label Grid.Row="2" Text="{Binding PopupWare.NameWareView}" FontAttributes="Bold" FontSize="16"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="0,15,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>