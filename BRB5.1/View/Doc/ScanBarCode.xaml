<?xml version="1.0" encoding="utf-8"?>

<controls:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:controls="clr-namespace:BRB6.View"
                          x:Class="BRB6.View.ScanBarCode">
    <NavigationPage.TitleView>
        <StackLayout Spacing="15" Orientation="Horizontal" Padding="0,0,10,0">
            <Label Text="Зберегти" VerticalOptions="Center" FontSize="Title">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveAsync" />
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>
    </NavigationPage.TitleView>
    <ContentPage.Resources>
        <controls:CodeUnitToKeyboardConverter x:Key="CodeUnitToKeyboardConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>

            <Frame Style="{StaticResource FrameStyle}">
                <controls:CustomEntry Style="{StaticResource EntryStyle}"
                                      Placeholder="назва"
                                      Text="{Binding NumberOutInvoice}"/>
            </Frame>

            <ListView ItemsSource="{Binding Doc}"
                      HorizontalOptions="StartAndExpand"
                      SeparatorVisibility="None">
                <ListView.Header>
                    <Grid RowSpacing="1"
                          ColumnSpacing="1"
                          Padding="1"
                          BackgroundColor="#adaea7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>                        

                        <Label Text="Штрихкод" Grid.ColumnSpan="2" BackgroundColor="White" />
                        <Label Text="Зберегти" Grid.Column="1" BackgroundColor="White" />

                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate xmlns:brb5="clr-namespace:BRB6">
                        <ViewCell>
                            <ViewCell.View>
                                <Grid RowSpacing="1"
                                      ColumnSpacing="1"
                                      Padding="1"
                                      BackgroundColor="#adaea7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Text="{Binding BarCode}" Grid.ColumnSpan="2" BackgroundColor="White" />

                                    <ImageButton Grid.Column="1" Source="save.png" HorizontalOptions="End"  VerticalOptions="Center"  WidthRequest="55" HeightRequest="55" 
              Padding="6" BackgroundColor="Transparent" IsVisible="{Binding IsSavedState}" Margin="0,0,12,0" /> <!--Clicked="SaveDoc_ClickedAsync"-->
                                </Grid>
                            </ViewCell.View>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ContentPage.Content>
</controls:BaseContentPage>